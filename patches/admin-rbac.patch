diff --git a/apps/api/src/tests/auth-role.test.js b/apps/api/src/tests/auth-role.test.js
new file mode 100644
--- /dev/null
+++ b/apps/api/src/tests/auth-role.test.js
@@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { requireRole } from "../middleware/auth.js";
+
+function createResponse() {
+  const state = { status: null, body: null };
+
+  return {
+    state,
+    status(code) {
+      state.status = code;
+      return this;
+    },
+    json(body) {
+      state.body = body;
+      return this;
+    }
+  };
+}
+
+test("requireRole allows configured roles", () => {
+  const req = { user: { role: "admin" } };
+  const res = createResponse();
+  let nextCalled = false;
+
+  requireRole("admin")(req, res, () => {
+    nextCalled = true;
+  });
+
+  assert.equal(nextCalled, true);
+  assert.equal(res.state.status, null);
+});
+
+test("requireRole rejects other authenticated roles", () => {
+  const req = { user: { role: "client" } };
+  const res = createResponse();
+  let nextCalled = false;
+
+  requireRole("admin")(req, res, () => {
+    nextCalled = true;
+  });
+
+  assert.equal(nextCalled, false);
+  assert.equal(res.state.status, 403);
+  assert.deepEqual(res.state.body, { success: false, message: "Forbidden" });
+});
+
+test("requireRole rejects requests without an authenticated user", () => {
+  const req = {};
+  const res = createResponse();
+  let nextCalled = false;
+
+  requireRole("admin")(req, res, () => {
+    nextCalled = true;
+  });
+
+  assert.equal(nextCalled, false);
+  assert.equal(res.state.status, 403);
+});
